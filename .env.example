# Copy this file to `.env` and fill in your Firebase project's values.
# (You can also paste your firebaseConfig directly into the app's setup screen
# if you'd rather not rebuild the app to change Firebase projects.)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Set this to your GitHub Pages base path when deploying.
# For https://<user>.github.io/baby-name-picker/ use:
#   VITE_BASE=/baby-name-picker/
VITE_BASE=/
